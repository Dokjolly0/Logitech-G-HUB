# Consistency test for docs/feature-matrix.md. Run with
#   cmake -DROOT=<source dir> -P CheckFeatureMatrix.cmake
# Checks: unique row IDs, known status symbols, tasks that exist in the
# roadmap, agent paths that exist in docs/re/agent_ws_paths.txt, and that
# every agent path is covered by a row or by an appendix prefix.
if(NOT ROOT)
    message(FATAL_ERROR "ROOT not set")
endif()

# Read a UTF-8 text file as a list of lines. ';' would split CMake list items,
# so it is turned into ','; file(STRINGS) is avoided because it cuts lines at
# non-ASCII bytes (the status symbols).
function(read_lines file out)
    file(READ "${file}" text)
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

read_lines("${ROOT}/docs/feature-matrix.md" all_lines)
set(lines "")
foreach(line IN LISTS all_lines)
    if(line MATCHES "^\\| ")
        list(APPEND lines "${line}")
    endif()
endforeach()
read_lines("${ROOT}/docs/re/agent_ws_paths.txt" agent_paths)
list(REMOVE_ITEM agent_paths "")
file(STRINGS "${ROOT}/docs/roadmap.md" roadmap REGEX "^- \\[[ x]\\] [0-9]+\\.[0-9]+ ")

set(tasks "")
foreach(line IN LISTS roadmap)
    string(REGEX MATCH "[0-9]+\\.[0-9]+" t "${line}")
    list(APPEND tasks "${t}")
endforeach()

set(statuses "✅" "🟡" "⬜" "➖" "⛔")
set(errors "")
set(ids "")
set(row_paths "")
set(prefixes "")
set(row_count 0)

foreach(line IN LISTS lines)
    string(REGEX REPLACE "^\\| (.*) \\|$" "\\1" body "${line}")
    string(REPLACE " | " ";" cells "${body}")
    list(LENGTH cells n)
    list(GET cells 0 first)

    if(first MATCHES "^[A-Z]+-[0-9]+$")
        math(EXPR row_count "${row_count} + 1")
        if(NOT n EQUAL 7)
            list(APPEND errors "${first}: expected 7 cells, found ${n}")
            continue()
        endif()
        list(GET cells 2 path_cell)
        list(GET cells 4 task_cell)
        list(GET cells 5 status)
        if(first IN_LIST ids)
            list(APPEND errors "${first}: duplicate ID")
        endif()
        list(APPEND ids "${first}")
        if(NOT status IN_LIST statuses)
            list(APPEND errors "${first}: unknown status '${status}'")
        endif()
        if(status STREQUAL "➖" OR status STREQUAL "⛔")
            if(NOT task_cell STREQUAL "—")
                list(APPEND errors "${first}: N/A or out-of-scope rows take task '—'")
            endif()
        else()
            string(REGEX MATCHALL "[0-9]+\\.[0-9]+" row_tasks "${task_cell}")
            if(NOT row_tasks)
                list(APPEND errors "${first}: no task")
            endif()
            foreach(t IN LISTS row_tasks)
                if(NOT t IN_LIST tasks)
                    list(APPEND errors "${first}: task ${t} not in roadmap.md")
                endif()
            endforeach()
        endif()
        string(REGEX MATCHALL "`/[^`]*`" found "${path_cell}")
        foreach(p IN LISTS found)
            string(REGEX REPLACE "^`(.*)`$" "\\1" p "${p}")
            string(REPLACE "{id}" "%(id)s" p "${p}")
            if(NOT p IN_LIST agent_paths)
                list(APPEND errors "${first}: path ${p} is not in agent_ws_paths.txt")
            endif()
            list(APPEND row_paths "${p}")
        endforeach()
    elseif(first MATCHES "^`/")
        list(GET cells 1 class)
        string(REGEX REPLACE "^`(.*)`$" "\\1" p "${first}")
        string(REPLACE "{id}" "%(id)s" p "${p}")
        if(NOT class STREQUAL "➖" AND NOT class STREQUAL "⛔")
            list(APPEND errors "appendix ${p}: class must be ➖ or ⛔")
        endif()
        if(p IN_LIST prefixes)
            list(APPEND errors "appendix ${p}: duplicate prefix")
        endif()
        list(APPEND prefixes "${p}")
    endif()
endforeach()

# Every appendix prefix must match something, every agent path must be covered.
set(used_prefixes "")
set(uncovered "")
foreach(path IN LISTS agent_paths)
    if(path STREQUAL "")
        continue()
    endif()
    set(covered FALSE)
    if(path IN_LIST row_paths)
        set(covered TRUE)
    endif()
    foreach(prefix IN LISTS prefixes)
        string(FIND "${path}" "${prefix}" pos)
        if(pos EQUAL 0)
            set(covered TRUE)
            list(APPEND used_prefixes "${prefix}")
        endif()
    endforeach()
    if(NOT covered)
        list(APPEND uncovered "${path}")
    endif()
endforeach()
foreach(prefix IN LISTS prefixes)
    if(NOT prefix IN_LIST used_prefixes)
        list(APPEND errors "appendix ${prefix}: matches no agent path")
    endif()
endforeach()
foreach(path IN LISTS uncovered)
    list(APPEND errors "agent path ${path} has no row and no appendix prefix")
endforeach()

if(errors)
    list(JOIN errors "\n  " text)
    message(FATAL_ERROR "feature-matrix.md:\n  ${text}")
endif()
list(LENGTH agent_paths path_count)
message(STATUS "Feature matrix OK: ${row_count} rows, ${path_count} agent paths covered")
