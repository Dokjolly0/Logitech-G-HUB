# Architecture test: Qt may only appear under ui/. Run with
#   cmake -DROOT=<source dir> -P CheckNoQt.cmake
if(NOT ROOT)
    message(FATAL_ERROR "ROOT not set")
endif()

set(guarded core ipc daemon cli tools)
set(violations "")
foreach(dir IN LISTS guarded)
    if(NOT EXISTS "${ROOT}/${dir}")
        continue()
    endif()
    file(GLOB_RECURSE files "${ROOT}/${dir}/*")
    foreach(f IN LISTS files)
        if(f MATCHES "\\.(h|hpp|c|cc|cpp|cxx|ipp)$")
            file(STRINGS "${f}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"](Q[A-Za-z]|qt)")
        elseif(f MATCHES "(CMakeLists\\.txt|\\.cmake)$")
            file(STRINGS "${f}" hits REGEX "(find_package[ \t]*\\([ \t]*Qt|Qt6::|Qt5::)")
        else()
            continue()
        endif()
        if(hits)
            list(APPEND violations "${f}: ${hits}")
        endif()
    endforeach()
endforeach()

if(violations)
    list(JOIN violations "\n  " text)
    message(FATAL_ERROR "Qt dependency outside ui/:\n  ${text}")
endif()
message(STATUS "Architecture OK: no Qt outside ui/")
